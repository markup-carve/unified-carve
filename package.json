{
  "name": "@markup-carve/unified-carve",
  "version": "0.1.0",
  "type": "module",
  "description": "unified parser plugin that turns Carve documents into mdast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markup-carve/unified-carve"
  },
  "keywords": [
    "carve",
    "markup",
    "unified",
    "remark",
    "mdast",
    "unified-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --test dist/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#eb2ffc1a18943bc3a865639c6481a4c0bc3b87c5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "property-information": "^7.2.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.2",
    "hast-util-from-html": "^2.1.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.7.2"
  }
}
